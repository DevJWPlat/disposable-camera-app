// The single app that serves every event (step 1 of the single-app plan).
// The old per-event configs are kept only for rolling back (see their notes).
{
  "name": "odc-events",
  "main": "worker/index.js",
  "compatibility_date": "2026-03-20",
  "workers_dev": false,
  // Every address this app serves. Any <slug>.onlinedisposablecamera.co.uk
  // reaches the Worker through the wildcard route; other domains need a
  // custom domain here and a row in event_domains. www is excluded by a
  // "no Worker" route in the dashboard, so the marketing site is untouched.
  "routes": [
    { "pattern": "*.onlinedisposablecamera.co.uk/*", "zone_name": "onlinedisposablecamera.co.uk" },
    { "pattern": "caz-and-dan.onlinedisposablecamera.co.uk", "custom_domain": true },
    { "pattern": "sophies-last-rodeo.party", "custom_domain": true },
    { "pattern": "sophies-last-rodeo.onlinedisposablecamera.co.uk", "custom_domain": true },
    // Theme demos
    { "pattern": "soft-film-demo.onlinedisposablecamera.co.uk", "custom_domain": true },
    { "pattern": "after-dark-demo.onlinedisposablecamera.co.uk", "custom_domain": true },
    { "pattern": "classic-editorial-demo.onlinedisposablecamera.co.uk", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/app",
    "not_found_handling": "single-page-application",
    // Pages need the Worker so it can add the event to index.html.
    // Built files under /assets/ are served straight from storage.
    "run_worker_first": ["/*", "!/assets/*"]
  },
  "vars": {
    "APP_DOMAIN": "onlinedisposablecamera.co.uk",
    "ADMIN_COOKIE_NAME": "odc_admin",
    // Storage job: "on" deletes expired events; anything else only reports.
    "STORAGE_DELETION": "off",
    "NOTIFY_EMAIL": "onlinedisposablecamera@gmail.com",
    // Admin builder at admin.onlinedisposablecamera.co.uk. It stays locked
    // until both Access values are filled in (see the Cloudflare Access app).
    "OWNER_EMAILS": "jonny.whittle@sky.com,hello@onlinedisposablecamera.co.uk,onlinedisposablecamera@gmail.com",
    "ACCESS_TEAM_DOMAIN": "green-wave-f82c.cloudflareaccess.com",
    "ACCESS_AUD": "3956be261b991e669b41037de61f887bb7cd6298e76b370f498e7a072f9258a7"
  },
  // Nightly storage job, 03:00 UTC (3am in winter, 4am in summer).
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "odc-events-db",
      "database_id": "17dca8cf-69a7-4944-bf32-a5405c1cd79c",
      "migrations_dir": "migrations-app"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "odc-event-photos"
    }
  ]
}

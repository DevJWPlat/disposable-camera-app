// The single app that serves every event (step 1 of the single-app plan).
// The old per-event configs are kept only for rolling back (see their notes).
{
  "name": "odc-events",
  "main": "worker/index.js",
  "compatibility_date": "2026-03-20",
  "workers_dev": false,
  // Every address this app serves. Each one also needs a row in event_domains,
  // or must be <slug>.onlinedisposablecamera.co.uk.
  "routes": [
    { "pattern": "caz-and-dan.onlinedisposablecamera.co.uk", "custom_domain": true },
    { "pattern": "sophies-last-rodeo.party", "custom_domain": true },
    { "pattern": "sophies-last-rodeo.onlinedisposablecamera.co.uk", "custom_domain": true },
    // Test address from patch 06, removed in the clean-up patch.
    { "pattern": "test-caz-and-dan.onlinedisposablecamera.co.uk", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/app",
    "not_found_handling": "single-page-application",
    // Pages need the Worker so it can add the event to index.html.
    // Built files under /assets/ are served straight from storage.
    "run_worker_first": ["/*", "!/assets/*"]
  },
  "vars": {
    "APP_DOMAIN": "onlinedisposablecamera.co.uk",
    "ADMIN_COOKIE_NAME": "odc_admin"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "odc-events-db",
      "database_id": "17dca8cf-69a7-4944-bf32-a5405c1cd79c",
      "migrations_dir": "migrations-app"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "odc-event-photos"
    },
    // Old per-event buckets, read only by the one-off copy in patch 05.
    // Removed once each event's storage period ends.
    {
      "binding": "LEGACY_PHOTOS_CAZ_AND_DAN",
      "bucket_name": "caz-and-dan-photos"
    },
    {
      "binding": "LEGACY_PHOTOS_SOPHIES_LAST_RODEO",
      "bucket_name": "sophies-last-rodeo-photos"
    }
  ]
}

// ROLLBACK ONLY. Caz & Dan now runs on the single app (wrangler.jsonc).
// To roll back: add this to the object below, then run
//   VITE_EVENT=caz-and-dan npx vite build && npx wrangler deploy --config wrangler.caz-and-dan.jsonc
// and answer y when asked to move the custom domain:
//   "routes": [{ "pattern": "caz-and-dan.onlinedisposablecamera.co.uk", "custom_domain": true }],
{
  "name": "caz-and-dan-camera",
  "main": "worker/legacy.js",
  "compatibility_date": "2026-03-20",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/caz-and-dan",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "EVENT_SLUG": "caz-and-dan",
    "ADMIN_COOKIE_NAME": "caz_dan_camera_admin"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "caz-and-dan-db",
      "database_id": "12bc0575-7eab-4485-81b1-972b880d4f91"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "caz-and-dan-photos"
    }
  ]
}

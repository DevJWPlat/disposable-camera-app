{
  "name": "disposable-camera-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "cf:dev": "vite build && wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "build:sophie": "VITE_EVENT=sophies-last-rodeo vite build",
    "build:caz": "VITE_EVENT=caz-and-dan vite build",
    "cf:dev:sophie": "VITE_EVENT=sophies-last-rodeo vite build && wrangler dev --config wrangler.sophie.jsonc",
    "cf:dev:caz": "VITE_EVENT=caz-and-dan vite build && wrangler dev --config wrangler.caz-and-dan.jsonc",
    "deploy:sophie": "VITE_EVENT=sophies-last-rodeo vite build && wrangler deploy --config wrangler.sophie.jsonc",
    "deploy:caz": "VITE_EVENT=caz-and-dan vite build && wrangler deploy --config wrangler.caz-and-dan.jsonc",
    "admin:invite": "node scripts/create-admin-invite.mjs",
    "dev:sophie": "VITE_EVENT=sophies-last-rodeo vite --host",
    "dev:caz": "VITE_EVENT=caz-and-dan vite --host"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "tailwindcss": "^4.2.2",
    "vue": "^3.5.29",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.4",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.50.0",
    "eslint-plugin-vue": "~10.8.0",
    "globals": "^17.3.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.50.0",
    "prettier": "3.8.1",
    "sass": "^1.98.0",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.6",
    "wrangler": "^4.76.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}

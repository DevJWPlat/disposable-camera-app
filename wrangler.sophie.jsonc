{
  "name": "sophies-last-rodeo-camera",
  "main": "worker/legacy.js",
  "compatibility_date": "2026-03-20",

  "routes": [
    {
      "pattern": "sophies-last-rodeo.party",
      "custom_domain": true
    }
  ],

  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/sophies-last-rodeo",
    "not_found_handling": "single-page-application"
  },

  "vars": {
    "EVENT_SLUG": "sophies-last-rodeo",
    "ADMIN_COOKIE_NAME": "sophie_camera_admin"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sophies-last-rodeo-db",
      "database_id": "6ab44800-6547-410e-896b-8226b7cbb1fc"
    }
  ],

  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "sophies-last-rodeo-photos"
    }
  ]
}